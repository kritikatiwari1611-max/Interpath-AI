# InternPath AI Environment Configuration
# Copy this file to .env and adjust variables as needed

# Flask Secret Key for session signing
SECRET_KEY=change-this-in-production-random-secret-key-internpath

# AI Engine Mode: "demo" (rule-based offline fallback) or "openai"
AI_MODE=demo

# OpenAI API Settings (Used only if AI_MODE=openai and key is provided)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Database Configuration (Leave empty to use local SQLite: internpath.db)
# For Supabase/Postgres, specify: postgresql://postgres:password@db.xxxx.supabase.co:5432/postgres
DATABASE_URL=

# Default Admin Account
ADMIN_EMAIL=admin@demo.com
